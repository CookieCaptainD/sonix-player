digraph avrcp_target_browsing {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#eef3fa", color="#33527a",
        fontname="DejaVu Sans", fontsize=11];
  edge [color="#33527a", fontname="DejaVu Sans", fontsize=9];

  car [label="Car head unit\nAVRCP controller"];
  daemon [label="Patched bluetoothd\nAVRCP browse PDUs"];
  bridge [label="D-Bus browser bridge\nserials, deadlines, cancel"];
  tree [label="Browse tree\nstable 64-bit UIDs"];
  library [label="Scanned library\nfolders and tracks"];
  play [label="Playback bridge\nUID to file"];
  output [label="Existing playback\nqueue, output"];
  mpris [label="v1.3.3 MPRIS player\nmetadata, keys"];
  stock [label="Stock bluetoothd\nfallback"];

  car -> daemon [label="AVCTP / PDU"];
  daemon -> bridge [label="D-Bus call"];
  bridge -> tree [label="UID lookup"];
  library -> tree [label="scan result"];
  tree -> bridge [label="names, child UIDs"];
  bridge -> daemon [label="D-Bus reply"];
  daemon -> car [label="AVCTP / PDU"];
  bridge -> play [label="PlayItem"];
  play -> output [label="start track"];
  mpris -> car [label="metadata, transport (unchanged)"];
  stock -> car [label="flag off"];
}
