+/* ------------------------------------------------------------------ */
+/* AVRCP target browsing bridge                                         */
+/* ------------------------------------------------------------------ */
+
+static void browse_items_cb(GSList *items, uint32_t total, void *user_data)
+{
+	struct media_player *mp = user_data;
+	GSList *out = NULL, *l;
+
+	for (l = items; l != NULL; l = l->next) {
+		struct media_browse_item *src = l->data;
+		struct tg_browse_item *item;
+
+		if (src == NULL)
+			continue;
+
+		item = g_new0(struct tg_browse_item, 1);
+		item->uid = src->uid;
+		item->type = src->type;
+		item->name = g_strdup(src->name);
+		out = g_slist_prepend(out, item);
+	}
+
+	out = g_slist_reverse(out);
+	avrcp_tg_browse_done(mp->player, out, total);
+}
+
+static void browse_error_cb(unsigned id, const char *dest, const char *msg,
+								void *user_data)
+{
+	struct media_player *mp = user_data;
+
+	/* Do not roll the UIDs back on an error: the CT must keep seeing a
+	 * monotonically stable namespace. */
+	DBG("browse call %u to %s failed: %s", id, dest != NULL ? dest : "", msg);
+}
+
+static void browse_done_cb(unsigned id, bool success, void *user_data)
+{
+	struct media_player *mp = user_data;
+
+	DBG("browse call %u %s", id, success ? "done" : "failed");
+}
+
+static const struct media_browse_cb browse_cb = {
+	.items = browse_items_cb,
+	.error = browse_error_cb,
+	.done = browse_done_cb,
+};
+
+static gboolean browse_dispatch_cb(gpointer user_data)
+{
+	struct media_player *mp = user_data;
+
+	media_browse_dispatch(mp->browse, 0);
+
+	return TRUE;
+}
+
+static uint32_t tg_get_total(uint32_t folder, void *user_data)
+{
+	struct media_player *mp = user_data;
+
+	if (mp->browse == NULL)
+		return 0;
+
+	return media_browse_count_sync(mp->browse, mp->sender, mp->path);
+}
+
+static GSList *tg_list_items(uint32_t folder, uint32_t start, uint32_t end,
+					uint32_t *total, void *user_data)
+{
+	struct media_player *mp = user_data;
+
+	if (mp->browse == NULL)
+		return NULL;
+
+	media_browse_list_items(mp->browse, mp->sender, mp->path, start, end);
+
+	return NULL;
+}
+
+static bool tg_get_item(uint64_t uid, char **name, uint8_t *type,
+								void *user_data)
+{
+	struct media_player *mp = user_data;
+	char uri[64];
+
+	if (mp->browse == NULL)
+		return false;
+
+	snprintf(uri, sizeof(uri), "/org/mpris/MediaPlayer2/Track/%llu",
+							(unsigned long long) uid);
+	*name = g_strdup(uri);
+	*type = TG_ITEM_SONG;
+
+	return true;
+}
+
+static bool tg_play_item(uint64_t uid, void *user_data)
+{
+	struct media_player *mp = user_data;
+	char uri[128];
+
+	if (mp->browse == NULL)
+		return false;
+
+	snprintf(uri, sizeof(uri), "file:///org/mpris/MediaPlayer2/Track/%llu",
+							(unsigned long long) uid);
+	media_browse_play(mp->browse, mp->sender, uri);
+
+	return true;
+}
+
+static void tg_reset_browse(void *user_data)
+{
+	struct media_player *mp = user_data;
+
+	if (mp->browse != NULL)
+		media_browse_cancel_dest(mp->browse, mp->sender);
+	mp->last_total = 0;
+}
