+static gboolean set_browsable(struct media_player *mp, DBusMessageIter *var)
+{
+	gboolean value;
+
+	if (dbus_message_iter_get_arg_type(var) != DBUS_TYPE_BOOLEAN)
+		return FALSE;
+
+	dbus_message_iter_get_basic(var, &value);
+	mp->browsable = value;
+
+	return TRUE;
+}
+
+static gboolean set_folder(struct media_player *mp, DBusMessageIter *var)
+{
+	const char *value;
+
+	if (dbus_message_iter_get_arg_type(var) != DBUS_TYPE_STRING)
+		return FALSE;
+
+	dbus_message_iter_get_basic(var, &value);
+
+	/* Keep the folder across ChangePath: only the UID cache survives. */
+	g_free(mp->folder);
+	mp->folder = g_strdup(value);
+
+	return TRUE;
+}
